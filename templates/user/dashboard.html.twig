{% extends 'base.html.twig' %}

{% block title %}User Dashboard{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">Welcome, {{ app.user.email }}!</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Profile Settings</h5>
                    <p class="card-text">Manage your account settings and preferences.</p>
                    <a href="#" class="btn btn-primary">Go to Profile</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Reservations</h5>
                    <p class="card-text">View and manage your reservations.</p>
                    <a href="#" class="btn btn-primary">View Reservations</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Commandes</h5>
                    <p class="card-text">Check your orders and purchase history.</p>
                    <a href="#" class="btn btn-primary">View Commandes</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
