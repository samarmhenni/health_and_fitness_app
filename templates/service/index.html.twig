{% extends 'base.html.twig' %}

{% block title %}Services - Health & Fitness{% endblock %}

{% block body %}
<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-3 text-white mb-4 animated slideInDown">Nos Services</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('home_redirect') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Services</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-fluid courses overflow-hidden py-5">
    <div class="container py-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
            <h4 class="text-primary">Nos Programmes</h4>
            <h1 class="display-4 text-white mb-4">Découvrez Nos Services</h1>
            <p class="text-white mb-0">Nous proposons une large gamme de services pour répondre à tous vos besoins en matière de fitness et de bien-être.</p>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="text-end mb-4">
            <a href="{{ path('app_service_new') }}" class="btn btn-primary py-2 px-4"><span><i class="fas fa-plus me-2"></i>Ajouter un service</span></a>
        </div>
        {% endif %}

        <div class="row gy-4 gx-0 justify-content-center">
            {% if services is empty %}
                <div class="col-12 text-center py-5">
                    <p class="text-white lead">Aucun service pour le moment.</p>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_service_new') }}" class="btn btn-primary py-3 px-5"><span>Ajouter un service</span></a>
                    {% endif %}
                </div>
            {% else %}
                {% for service in services %}
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="courses-item">
                        <div class="courses-item-inner p-4">
                            <div class="d-flex justify-content-between mb-4">
                                <div class="courses-icon-img p-3">
                                    {% if service.image %}
                                        <img src="{{ service.image }}" class="img-fluid" alt="{{ service.name }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%;">
                                    {% else %}
                                        <img src="{{ asset('fitness/img/icon-1.png') }}" class="img-fluid" alt="">
                                    {% endif %}
                                </div>
                                <div class="data-info d-flex flex-column">
                                    <div class="courses-date">
                                        <p class="mb-1 text-primary h5">{{ service.price|number_format(2, ',', ' ') }} DT</p>
                                    </div>
                                </div>
                            </div>
                            <a href="{{ path('app_service_show', {'id': service.id}) }}" class="d-inline-block h4 mb-3">{{ service.name }}</a>
                            <p class="mb-4">{{ service.description|length > 100 ? service.description|slice(0, 100) ~ '...' : service.description }}</p>
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn btn-primary py-2 px-4"><span>Voir Détails</span></a>
                                <a href="{{ path('app_reservation_new', {'serviceId': service.id}) }}" class="btn btn-dark py-2 px-4"><span>Réserver</span></a>
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                            <div class="mt-3 d-flex gap-2">
                                <a href="{{ path('app_service_edit', {'id': service.id}) }}" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Modifier</a>
                                <form action="{{ path('app_service_delete', {'id': service.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce service ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Supprimer</button>
                                </form>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
