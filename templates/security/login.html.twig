{% extends 'base.html.twig' %}

{% block title %}Connexion - Health & Fitness{% endblock %}

{% block body %}
<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-3 text-white mb-4 animated slideInDown">Connexion</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('home_redirect') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Connexion</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.2s">
            <div class="bg-dark p-5" style="border-radius: 10px;">
                <h2 class="text-white text-center mb-4">Se Connecter</h2>
                
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        <script>
                            window.location.href = "{{ path('home_redirect') }}";
                        </script>
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-4">
                        <label for="inputEmail" class="form-label text-white">Email</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control py-3" autocomplete="email" required autofocus placeholder="Votre email">
                    </div>
                    <div class="mb-4">
                        <label for="inputPassword" class="form-label text-white">Mot de passe</label>
                        <input type="password" name="password" id="inputPassword" class="form-control py-3" autocomplete="current-password" required placeholder="Votre mot de passe">
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid mb-4">
                        <button class="btn btn-primary py-3" type="submit">
                            <span>Se Connecter</span>
                        </button>
                    </div>
                </form>
                <p class="text-center text-white mb-0">Pas encore de compte? <a href="{{ path('app_register') }}" class="text-primary">S'inscrire</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
