{% extends 'base.html.twig' %}

{% block title %}Produits - Health & Fitness{% endblock %}

{% block body %}
<!-- Page Header Start -->
<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container text-center py-5">
        <h1 class="display-3 text-white mb-4 animated slideInDown">Nos Produits</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('home_redirect') }}">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Produits</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->

<div class="container-fluid team py-5">
    <div class="container py-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
            <h4 class="text-primary">Notre Boutique</h4>
            <h1 class="display-4 mb-4">Équipements & Suppléments</h1>
            <p class="mb-0">Découvrez notre sélection de produits de qualité pour accompagner votre entraînement.</p>
        </div>
        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="text-end mb-4">
            <a href="{{ path('app_product_new') }}" class="btn btn-primary py-2 px-4"><span><i class="fas fa-plus me-2"></i>Ajouter un produit</span></a>
        </div>
        {% endif %}

        <div class="row gy-5 gy-lg-4 gx-4">
            {% if products is empty %}
                <div class="col-12 text-center py-5">
                    <p class="lead">Aucun produit pour le moment.</p>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_product_new') }}" class="btn btn-primary py-3 px-5"><span>Ajouter un produit</span></a>
                    {% endif %}
                </div>
            {% else %}
                {% for product in products %}
                <div class="col-md-6 col-lg-3 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="team-item">
                        <div class="team-img">
                            {% if product.image %}
                                <img src="{{ product.image }}" class="img-fluid w-100" alt="{{ product.name }}" style="height: 250px; object-fit: cover;">
                            {% else %}
                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <span class="text-muted"><i class="fas fa-image fa-3x"></i></span>
                                </div>
                            {% endif %}
                            <div class="team-icon">
                                <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-primary btn-sm-square"><i class="fas fa-eye"></i></a>
                                {% if not is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('cart_add', {'id': product.id}) }}" class="btn btn-primary btn-sm-square"><i class="fas fa-shopping-cart"></i></a>
                                {% else %}
                                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-primary btn-sm-square"><i class="fas fa-edit"></i></a>
                                {% endif %}
                            </div>
                        </div>
                        <div class="team-content">
                            <h4>{{ product.name }}</h4>
                            <p class="mb-0 text-primary">{{ product.price|number_format(2, ',', ' ') }} DT</p>
                            <small class="text-muted">Stock: {{ product.stock }}</small>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}