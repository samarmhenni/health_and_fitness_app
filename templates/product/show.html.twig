{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Health & Fitness{% endblock %}

{% block body %}
<div class="container">
    <div class="card mx-auto" style="max-width: 600px;">
        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
            {% if product.image %}
                <img src="{{ product.image }}" class="img-fluid" alt="{{ product.name }}" style="max-height: 380px; object-fit: contain;">
            {% else %}
                <div class="text-muted text-center"><i class="fas fa-image fa-5x"></i><br><br>Pas d'image disponible</div>
            {% endif %}
        </div>
        <div class="card-body text-center">
            <h2>{{ product.name }}</h2>
            <p class="lead">{{ product.description }}</p>
            <p class="h3 text-success mb-2">{{ product.price|number_format(2, ',', ' ') }} DT</p>
            <p class="text-muted mb-4">
                {% if product.stock > 0 %}
                    <span class="badge bg-success">En stock ({{ product.stock }})</span>
                {% else %}
                    <span class="badge bg-danger">Rupture de stock</span>
                {% endif %}
            </p>
            {% if product.stock > 0 %}
                <a href="{{ path('cart_add', {'id': product.id}) }}" class="btn btn-success btn-lg me-2">🛒 Ajouter au panier</a>
            {% else %}
                <button class="btn btn-secondary btn-lg me-2" disabled>🛒 Indisponible</button>
            {% endif %}
            <a href="{{ path('app_products') }}" class="btn btn-secondary btn-lg">Retour aux produits</a>
            
            {% if is_granted('ROLE_ADMIN') %}
                <hr class="my-4">
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning">✏️ Modifier</a>
                    <form action="{{ path('app_product_delete', {'id': product.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                        <button type="submit" class="btn btn-danger">🗑️ Supprimer</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}