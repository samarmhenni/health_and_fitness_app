<!DOCTYPE html>
<html lang="fr">

    <head>
        <meta charset="utf-8">
        <title>{% block title %}Health & Fitness{% endblock %}</title>
        <meta content="width=device-width, initial-scale=1.0" name="viewport">
        <meta content="health, fitness, gym" name="keywords">
        <meta content="Health & Fitness - Votre centre de remise en forme" name="description">

        <!-- Google Web Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Teko:wght@300..700&display=swap" rel="stylesheet">

        <!-- Icon Font Stylesheet -->
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

        <!-- Libraries Stylesheet -->
        <link rel="stylesheet" href="{{ asset('fitness/lib/animate/animate.min.css') }}"/>
        <link href="{{ asset('fitness/lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">

        <!-- Customized Bootstrap Stylesheet -->
        <link href="{{ asset('fitness/css/bootstrap.min.css') }}" rel="stylesheet">

        <!-- Template Stylesheet -->
        <link href="{{ asset('fitness/css/style.css') }}" rel="stylesheet">

        {% block stylesheets %}{% endblock %}
    </head>

    <body>

        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->

        <!-- Navbar & Hero Start -->
        <div class="container-fluid header-top">
            <div class="nav-shaps-2"></div>
            <div class="container d-flex align-items-center">
                <div class="d-flex align-items-center h-100">
                    <a href="{{ path('home_redirect') }}" class="navbar-brand" style="height: 125px;">
                        <h1 class="text-primary mb-0"><i class="fas fa-hand-rock me-2"></i> Fitness</h1>
                    </a>
                </div>
                <div class="w-100 h-100">
                    <div class="topbar px-0 py-2 d-none d-lg-block" style="height: 45px;">
                        <div class="row gx-0 align-items-center">
                            <div class="col-lg-8 text-center text-lg-center mb-lg-0">
                                <div class="d-flex flex-wrap">
                                    <div class="pe-4">
                                        <a href="mailto:contact@fitness.com" class="text-muted small"><i class="fas fa-envelope text-primary me-2"></i>contact@fitness.com</a>
                                    </div>
                                    <div class="pe-0">
                                        <span class="text-muted small"><i class="fa fa-clock text-primary me-2"></i>Lun - Sam: 8.00 - 19.00</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 text-center text-lg-end">
                                <div class="d-flex justify-content-end">
                                    <div class="d-flex align-items-center small">
                                        {% if app.user %}
                                            <a href="{{ path('app_logout') }}" class="login-btn text-body me-3 pe-3"><span>Déconnexion</span></a>
                                            <a href="{{ path('home_user') }}" class="text-body me-3">{{ app.user.name }}</a>
                                        {% else %}
                                            <a href="{{ path('app_login') }}" class="login-btn text-body me-3 pe-3"><span>Connexion</span></a>
                                            <a href="{{ path('app_register') }}" class="text-body me-3">Inscription</a>
                                        {% endif %}
                                    </div>
                                    <div class="d-flex pe-3">
                                        <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-facebook-f"></i></a>
                                        <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-twitter"></i></a>
                                        <a class="btn p-0 text-primary me-3" href="#"><i class="fab fa-instagram"></i></a>
                                        <a class="btn p-0 text-primary me-0" href="#"><i class="fab fa-linkedin-in"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="nav-bar px-0 py-lg-0" style="height: 80px;">
                        <nav class="navbar navbar-expand-lg navbar-light d-flex justify-content-lg-end">
                            <a href="{{ path('home_redirect') }}" class="navbar-brand-2">
                                <h1 class="text-primary mb-0"><i class="fas fa-hand-rock me-2"></i> Fitness</h1>
                            </a> 
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                                <span class="fa fa-bars"></span>
                            </button>
                            <div class="collapse navbar-collapse" id="navbarCollapse">
                                <div class="navbar-nav mx-0 mx-lg-auto">
                                    <a href="{{ path('home_redirect') }}" class="nav-item nav-link {{ app.request.attributes.get('_route') == 'home_redirect' ? 'active' : '' }}">Accueil</a>
                                    <a href="{{ path('app_products') }}" class="nav-item nav-link {{ app.request.attributes.get('_route') starts with 'app_product' ? 'active' : '' }}">Produits</a>
                                    <a href="{{ path('app_services') }}" class="nav-item nav-link {{ app.request.attributes.get('_route') starts with 'app_service' ? 'active' : '' }}">Services</a>
                                    <div class="nav-item dropdown">
                                        <a href="#" class="nav-link" data-bs-toggle="dropdown">
                                            <span class="dropdown-toggle">Mon Compte</span>
                                        </a>
                                        <div class="dropdown-menu">
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('admin_users') }}" class="dropdown-item">Gérer Utilisateurs</a>
                                            {% else %}
                                                <a href="{{ path('app_reservations') }}" class="dropdown-item">Mes Réservations</a>
                                                <a href="{{ path('app_orders') }}" class="dropdown-item">Mes Commandes</a>
                                                <a href="{{ path('app_cart') }}" class="dropdown-item">Mon Panier</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% if not is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_cart') }}" class="nav-item nav-link">
                                        <i class="fas fa-shopping-cart"></i> Panier
                                    </a>
                                    {% endif %}
                                    <div class="nav-shaps-1"></div>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
        <!-- Navbar & Hero End -->

        <!-- Flash Messages -->
        <div class="container mt-3">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <!-- Main Content -->
        {% block body %}{% endblock %}

        <!-- Footer Start -->
        <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
            <div class="container py-5">
                <div class="row g-5 mb-5 align-items-center">
                    <div class="col-lg-7">
                        <div class="position-relative d-flex" style="transform: skew(18deg);">
                            <input class="form-control border-0 w-100 py-3 pe-5" type="text" placeholder="Adresse email pour s'abonner">
                            <button type="button" class="btn-primary py-2 px-4 ms-3"><span>S'abonner</span></button>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="d-flex align-items-center justify-content-center justify-content-lg-end">
                            <a class="btn btn-primary btn-md-square me-3" href="#"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-primary btn-md-square me-3" href="#"><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-primary btn-md-square me-3" href="#"><i class="fab fa-instagram"></i></a>
                            <a class="btn btn-primary btn-md-square me-0" href="#"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                </div>
                <div class="row g-5">
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item">
                            <h4 class="text-white mb-4"><i class="fas fa-hand-rock text-primary me-2"></i> Fitness</h4>
                            <p class="mb-0">Votre centre de remise en forme vous accompagne dans l'atteinte de vos objectifs de santé et de bien-être.</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item">
                            <h4 class="text-white mb-4">Liens Rapides</h4>
                            <a href="{{ path('home_redirect') }}">Accueil</a>
                            <a href="{{ path('app_products') }}">Nos Produits</a>
                            <a href="{{ path('app_services') }}">Nos Services</a>
                            <a href="{{ path('app_reservations') }}">Réservations</a>
                            <a href="{{ path('app_cart') }}">Panier</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item">
                            <h4 class="text-white mb-4">Contact</h4>
                            <div class="row g-2">
                                <div class="col-12">
                                    <div class="d-flex">
                                        <i class="fas fa-map-marker-alt text-primary me-2"></i>
                                        <div>
                                            <h5 class="text-white mb-2">Adresse</h5>
                                            <p class="mb-0">123 Rue du Sport, Tunis</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex">
                                        <i class="fas fa-envelope text-primary me-2"></i>
                                        <div>
                                            <h5 class="text-white mb-2">Email</h5>
                                            <p class="mb-0">contact@fitness.com</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex">
                                        <i class="fa fa-phone-alt text-primary me-2"></i>
                                        <div>
                                            <h5 class="text-white mb-2">Téléphone</h5>
                                            <p class="mb-0">+216 12 345 678</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-6 col-xl-3">
                        <div class="footer-item">
                            <h4 class="text-white mb-4">Horaires</h4>
                            <div class="row g-2">
                                <div class="col-12">
                                    <p class="text-white mb-1"><strong>Lundi - Vendredi:</strong></p>
                                    <p class="mb-2">06:00 - 22:00</p>
                                </div>
                                <div class="col-12">
                                    <p class="text-white mb-1"><strong>Samedi:</strong></p>
                                    <p class="mb-2">08:00 - 20:00</p>
                                </div>
                                <div class="col-12">
                                    <p class="text-white mb-1"><strong>Dimanche:</strong></p>
                                    <p class="mb-0">09:00 - 18:00</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->

        
        <!-- Copyright Start -->
        <div class="container-fluid copyright py-4">
            <div class="container">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-md-0">
                        <span class="text-body"><a href="#" class="border-bottom text-white"><i class="fas fa-copyright text-light me-2"></i>Health & Fitness</a>, Tous droits réservés.</span>
                    </div>
                    <div class="col-md-6 text-center text-md-end text-body">
                        Template par <a class="border-bottom text-white" href="https://htmlcodex.com">HTML Codex</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Copyright End -->


        <!-- Back to Top -->
        <div class="back-to-top">
            <a href="#" class="btn"><i class="fa fa-arrow-up"></i></a>  
        </div> 

        
        <!-- JavaScript Libraries -->
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ asset('fitness/lib/wow/wow.min.js') }}"></script>
        <script src="{{ asset('fitness/lib/easing/easing.min.js') }}"></script>
        <script src="{{ asset('fitness/lib/waypoints/waypoints.min.js') }}"></script>
        <script src="{{ asset('fitness/lib/owlcarousel/owl.carousel.min.js') }}"></script>
        

        <!-- Template Javascript -->
        <script src="{{ asset('fitness/js/main.js') }}"></script>

        {% block javascripts %}{% endblock %}
    </body>

</html>