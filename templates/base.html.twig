<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Health & Fitness{% endblock %}</title>
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('home_redirect') }}">🏋️ Health & Fitness</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_products') }}">🛍️ Produits</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_services') }}">💪 Services</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_reservations') }}">📅 Réservations</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_orders') }}">📦 Commandes</a>
                </li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_cart') }}">🛒 Panier</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('home_user') }}">👤 Utilisateurs</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{# Admin-side vertical Add Product button (fixed) #}
{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_product_new') }}"
       class="btn btn-primary shadow"
       style="position:fixed; left:12px; top:50%; transform:translateY(-50%); z-index:1050; writing-mode:vertical-rl; text-orientation:mixed; border-radius:8px; padding:10px 14px;">
        + Add product
    </a>
{% endif %}

<main class="container mt-4">
    {% block body %}{% endblock %}
</main>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
</body>
</html>