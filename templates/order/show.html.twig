{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }} - Health & Fitness{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Commande #{{ order.id }}</h1>
        <a href="{{ path('app_orders') }}" class="btn btn-secondary">Retour à mes commandes</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    Articles
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Prix unitaire</th>
                                <th>Quantité</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in order.items %}
                                <tr>
                                    <td>{{ item.product.name }}</td>
                                    <td>{{ item.price|number_format(2, ',', ' ') }} DT</td>
                                    <td>{{ item.quantity }}</td>
                                    <td>{{ (item.price * item.quantity)|number_format(2, ',', ' ') }} DT</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total Commande :</td>
                                <td class="fw-bold text-success">{{ order.total|number_format(2, ',', ' ') }} DT</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Informations
                </div>
                <div class="card-body">
                    <p><strong>Date :</strong> {{ order.createdAt|date('d/m/Y H:i') }}</p>
                    <p><strong>Statut :</strong> 
                        {% if order.status == 'PENDING' %}
                            <span class="badge bg-warning text-dark">En attente</span>
                        {% elseif order.status == 'COMPLETED' %}
                            <span class="badge bg-success">Terminée</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ order.status }}</span>
                        {% endif %}
                    </p>
                    <p><strong>Client :</strong> {{ order.user.name }} {{ order.user.lastName }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
