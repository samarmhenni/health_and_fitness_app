{% extends 'base.html.twig' %}

{% block title %}Détails de la réservation{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Réservation #{{ reservation.id }}</h1>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Service : {{ reservation.service.name }}</h5>
            <p class="card-text"><strong>Date :</strong> {{ reservation.reservationDate|date('d/m/Y H:i') }}</p>
            <p class="card-text"><strong>Statut :</strong> {{ reservation.status }}</p>
            <p class="card-text"><strong>Prix :</strong> {{ reservation.service.price }} €</p>
            <p class="card-text"><strong>Créée le :</strong> {{ reservation.createdAt|date('d/m/Y H:i') }}</p>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_reservations') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
</div>
{% endblock %}
